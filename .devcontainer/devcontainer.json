{
  "name": "scGPT Dev",
  "image": "scgpt-dev",
  "workspaceFolder": "/workspace/notebooks",
  "runArgs": ["--gpus", "all"],
  "mounts": [
    "source=/home/ddalton/projects/scGPT_playground,target=/workspace/notebooks,type=bind",
    "source=/aloy/home/ddalton/git_clones/scGPT,target=/workspace/scGPT,type=bind"
  ],
  "postCreateCommand": "pip install -e /workspace/scGPT && pip install 'flash-attn<1.0.5'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
